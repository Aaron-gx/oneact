{
  "productName": "一幕 OneAct",
  "version": "0.5.0",
  "identifier": "dev.oneact.desktop",
  "build": {
    "beforeDevCommand": "node ../web/build.mjs",
    "beforeBuildCommand": "node ../web/build.mjs",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "一幕 OneAct · AI 演示框架",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "Productivity"
  }
}
